{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "skills.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": { "const": 1 },
    "skills": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "contexts", "confidence", "evidence_refs"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" }, "name": { "$ref": "common.schema.json#/$defs/text" }, "category": { "type": ["string", "null"] },
        "contexts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/context" } },
        "confidence": { "enum": ["foundational", "working", "proficient", "advanced", null] }, "last_used": { "$ref": "common.schema.json#/$defs/date" },
        "notes": { "type": ["string", "null"] }, "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/id" } }
      }
    } }
  }
}
